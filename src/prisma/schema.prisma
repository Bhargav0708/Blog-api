// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum InteractionsTypes {
  LIKE
  SHARE
  BOOKMARK
}

model User {
  user_id         Int    @id @default(autoincrement())
  name            String
  email           String @unique
  password        String
  profile_picture String
  bio             String

  Posts       Post[]
  Comments    Comment[]
  Interaction Interaction[]

  @@map("users")
}

model Post {
  post_id      Int           @id @default(autoincrement())
  author_id    Int
  post_content String
  Tag          String
  Title        String
  author       User          @relation(fields: author_id, references: user_id, onDelete: Cascade,onUpdate: Cascade)
  Interaction  Interaction[]
  Comment      Comment[]

  @@map("posts")
}

model Comment {
  comment_id       Int    @id @default(autoincrement())
  commented_userid Int
  comment_content  String
  post_id          Int
  commented_post   Post   @relation(fields: post_id, references: post_id, onDelete: Cascade,onUpdate: Cascade)
  commented_user   User   @relation(fields: commented_userid, references: user_id, onDelete: Cascade,onUpdate: Cascade)

  @@map("comments")
}

model Interaction {
  interaction_id   Int               @id @default(autoincrement())
  user_id          Int
  post_id          Int
  interaction_type InteractionsTypes
  interacted_user  User              @relation(fields: user_id, references: user_id,onDelete:Cascade,onUpdate: Cascade)
  interacted_post  Post              @relation(fields: post_id, references: post_id,onDelete: Cascade,onUpdate: Cascade)

  @@map("interactions")
}
